generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DebugSettings {
  id                 String   @id @default(cuid())
  key                String   @unique
  headerBlendMode    String
  showSectionsEnabled Boolean
  hero3dParams       Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
